{%- comment -%} Row of trust badges (icon + title + short text) under the banner, with an optional headline. {%- endcomment -%}
<section class="lillo-trust">
  <div class="lillo-wrap">
    <ul class="lillo-trust__grid">
      {%- for block in section.blocks -%}
        <li class="lillo-trust__item" {{ block.shopify_attributes }}>
          <span class="lillo-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l7 2.5v5.5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V5.5z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9h11a5 5 0 010 10H9"/><path d="M8 5L4 9l4 4"/></svg>
              {%- when 'card' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/></svg>
            {%- endcase -%}
          </span>
          <span>
            <strong class="lillo-trust__title">{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}
              <span class="lillo-trust__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.headline != blank -%}
      <h2 class="lillo-trust__headline">{{ section.settings.headline }}</h2>
    {%- endif -%}
  </div>
</section>

<style>
  .lillo-trust { background: var(--lillo-bg); padding-block: 40px 24px; }
  .lillo-trust__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
  }
  .lillo-trust__item {
    display: flex; align-items: center; gap: 14px;
    padding: 18px 20px; border-radius: var(--lillo-radius);
    background: var(--lillo-surface); border: 1px solid var(--lillo-line);
  }
  .lillo-trust__icon {
    flex: none; width: 46px; height: 46px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--lillo-sand); color: var(--lillo-ink);
  }
  .lillo-trust__icon svg { width: 24px; height: 24px; }
  .lillo-trust__title { display: block; font-size: .95rem; font-weight: 600; }
  .lillo-trust__text { display: block; font-size: .82rem; color: var(--lillo-muted); margin-top: 2px; }
  .lillo-trust__headline {
    text-align: center; margin: 44px 0 0;
    font-family: var(--font-heading--family); font-weight: 600; font-size: clamp(1.4rem, 2.6vw, 2rem);
  }
  @media (max-width: 990px) { .lillo-trust__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) {
    .lillo-trust__grid { gap: 10px; }
    .lillo-trust__item { flex-direction: column; text-align: center; padding: 16px 10px; gap: 10px; }
  }
</style>

{% schema %}
{
  "name": "lillo: უპირატესობები",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "headline", "label": "სათაური ქვემოთ" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "უპირატესობა",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "იკონი",
          "options": [
            { "value": "truck", "label": "მიწოდება" },
            { "value": "shield", "label": "გარანტია" },
            { "value": "return", "label": "დაბრუნება" },
            { "value": "card", "label": "გადახდა" },
            { "value": "star", "label": "ვარსკვლავი" }
          ],
          "default": "star"
        },
        { "type": "text", "id": "title", "label": "სათაური", "default": "უპირატესობა" },
        { "type": "text", "id": "text", "label": "ტექსტი" }
      ]
    }
  ],
  "presets": [{ "name": "lillo: უპირატესობები" }]
}
{% endschema %}
