{%- comment -%}
  One category block on the homepage: wide banner with the category button, heading + text, then a row of products.
  Add this section once per category in the theme editor.
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading | default: collection.title
  assign banner = section.settings.image | default: collection.image
-%}
<section class="lillo-cat" style="--cat-from: {{ section.settings.color_from }}; --cat-to: {{ section.settings.color_to }};">
  <div class="lillo-wrap">
    <a class="lillo-cat__banner" href="{{ collection.url | default: routes.all_products_collection_url }}">
      {%- if banner -%}
        {{ banner | image_url: width: 2000 | image_tag: class: 'lillo-cat__img', sizes: '(min-width: 1280px) 1240px, 100vw', widths: '600, 1000, 1400, 2000', loading: 'lazy' }}
      {%- endif -%}
      <span class="lillo-cat__label">{{ collection.title | default: heading }}</span>
    </a>

    <div class="lillo-cat__intro">
      <h2 class="lillo-cat__heading">{{ heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lillo-cat__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="lillo-cat__grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {%- render 'lillo-card', product: product, show_perks: section.settings.show_perks -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="lillo-card">
            <div class="lillo-card__media">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            <p class="lillo-card__title">პროდუქტის სახელი</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if collection.products_count > section.settings.limit -%}
      <div class="lillo-cat__more">
        <a class="lillo-btn" href="{{ collection.url }}">ყველას ნახვა ({{ collection.products_count }}) →</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .lillo-cat { background: var(--lillo-bg); padding-block: 36px 56px; }
  .lillo-cat__banner {
    position: relative; display: grid; place-items: center; overflow: hidden;
    min-height: clamp(200px, 28vw, 340px); border-radius: calc(var(--lillo-radius) * 1.5);
    background: linear-gradient(120deg, var(--cat-from), var(--cat-to));
    text-decoration: none;
  }
  .lillo-cat__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s ease; }
  .lillo-cat__banner:hover .lillo-cat__img { transform: scale(1.03); }
  .lillo-cat__label {
    position: relative; padding: 14px 30px; border-radius: 999px;
    background: rgba(255,255,255,.92); color: var(--lillo-ink);
    font-family: var(--font-heading--family); font-weight: 600; font-size: 1.15rem;
    box-shadow: 0 8px 30px rgba(30,26,22,.12);
    transition: background .2s ease, color .2s ease;
  }
  .lillo-cat__banner:hover .lillo-cat__label { background: var(--lillo-ink); color: #fff; }
  .lillo-cat__intro { text-align: center; max-width: 720px; margin: 36px auto 28px; }
  .lillo-cat__heading { margin: 0; font-family: var(--font-heading--family); font-weight: 600; font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .lillo-cat__text { margin: 12px 0 0; color: var(--lillo-muted); line-height: 1.7; }
  .lillo-cat__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px 20px; }
  .lillo-cat__more { text-align: center; margin-top: 36px; }
  @media (max-width: 990px) { .lillo-cat__grid { grid-template-columns: repeat(2, 1fr); gap: 24px 14px; } }
</style>

{% schema %}
{
  "name": "lillo: კატეგორია",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "კატეგორია" },
    { "type": "image_picker", "id": "image", "label": "ბანერის სურათი", "info": "თუ ცარიელია, გამოჩნდება კატეგორიის სურათი ან ფერადი ფონი" },
    { "type": "color", "id": "color_from", "label": "ბანერის ფონი 1", "default": "#efe7dc" },
    { "type": "color", "id": "color_to", "label": "ბანერის ფონი 2", "default": "#d9c8b4" },
    { "type": "text", "id": "heading", "label": "სათაური", "info": "თუ ცარიელია, გამოჩნდება კატეგორიის სახელი" },
    { "type": "textarea", "id": "text", "label": "აღწერა" },
    { "type": "range", "id": "limit", "label": "პროდუქტების რაოდენობა", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_perks", "label": "აჩვენე \"უფასო მიწოდება\" და \"ხარისხის გარანტია\"", "default": true }
  ],
  "presets": [{ "name": "lillo: კატეგორია" }]
}
{% endschema %}
